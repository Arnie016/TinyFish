{
  "name": "tinyfish-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Radar hackathon MVP: a TinyFish-aware MCP server and widget for compiling public workflows into Codex skills.",
  "scripts": {
    "build:widget": "INPUT=mcp-app.html vite build",
    "build": "tsc --noEmit && npm run build:widget && tsc -p tsconfig.server.json",
    "dev": "concurrently \"INPUT=mcp-app.html vite build --watch\" \"tsx watch main.ts\"",
    "start": "npm run build && node dist/main.js",
    "start:stdio": "npm run build && node dist/main.js --stdio",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.3.2",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vite-plugin-singlefile": "^2.3.2"
  }
}
